<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Keystone.WebApi.Templates</PackageId>
    <PackageVersion>0.2.0</PackageVersion>
    <Title>Keystone Web API Template</Title>
    <Authors>Ruel Belmonte</Authors>
    <Description>An opinionated .NET 10 minimal API solution template: endpoint, service, validator and repository layers, a ServiceResult/ApiError error flow, Dapper on Postgres, JWT scope policies, Serilog, and in-memory system tests. Install, then `dotnet new keystone -n MyProject`.</Description>
    <PackageTags>dotnet-new;templates;webapi;minimal-api;dapper;postgres</PackageTags>

    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- A template package ships content, not a lib; suppress the "no dll" warning. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*"
             Exclude="content\**\bin\**;content\**\obj\**;content\**\*.db;content\**\.vs\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
