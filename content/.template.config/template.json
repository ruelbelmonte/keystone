{
  "$schema": "http://json.schemastore.org/template",
  "author": "Ruel Belmonte",
  "classifications": ["Web", "Clean Architecture", "DDD", "CQRS", "Solution"],
  "identity": "Keystone.CleanArchitecture.Solution",
  "name": "Keystone Clean Architecture Solution (DDD + CQRS)",
  "shortName": "keystone",
  "sourceName": "Keystone",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Skip the automatic dotnet restore after the project is created."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/.vs/**",
            "**/*.db",
            "**/*.user"
          ]
        }
      ]
    }
  ],
  "postActions": [
    {
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages",
      "manualInstructions": [{ "text": "Run 'dotnet restore'" }],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
