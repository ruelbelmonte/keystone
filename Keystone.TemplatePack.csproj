<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Keystone.CleanArchitecture.Templates</PackageId>
    <PackageVersion>0.1.0</PackageVersion>
    <Title>Keystone Clean Architecture Template</Title>
    <Authors>Ruel Belmonte</Authors>
    <Description>An enterprise-grade Clean Architecture / DDD solution template: CQRS with MediatR, EF Core, domain events, the Result pattern, and architecture tests that enforce the layering. Install, then `dotnet new keystone -n MyProject`.</Description>
    <PackageTags>dotnet-new;templates;clean-architecture;ddd;cqrs;mediatr</PackageTags>

    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- A template package ships content, not a lib; suppress the "no dll" warning. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*"
             Exclude="content\**\bin\**;content\**\obj\**;content\**\*.db;content\**\.vs\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
